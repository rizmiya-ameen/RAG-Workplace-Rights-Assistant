# Copy to backend/.env and fill in. .env is git-ignored: never commit real values.

APP_ENV=dev

# Postgres 18 + pgvector. Dev: Neon (neon.tech) connection string, e.g.
#   postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
# Or a local Docker Postgres (see docker-compose.yml):
#   postgresql://wra:wra@127.0.0.1:5432/wra
DATABASE_URL=

# LLM: any OpenAI-compatible endpoint (from build step 10).
# Hosted (Azure OpenAI or similar):
#   LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1
#   LLM_API_KEY=<key>
#   LLM_MODEL=<deployment name>
# Offline: Ollama on this machine
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT_S=120
