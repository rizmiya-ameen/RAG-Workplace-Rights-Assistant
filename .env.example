# Copy to backend/.env and fill in. .env is git-ignored: never commit real values.

APP_ENV=dev

# Postgres 18 + pgvector. Dev: Neon (neon.tech) connection string, e.g.
#   postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
# Or a local Docker Postgres (see docker-compose.yml):
#   postgresql://wra:wra@127.0.0.1:5432/wra
DATABASE_URL=

# LLM: any OpenAI-compatible endpoint (from build step 10). Switching = these three values.
# Default: Google Gemini free tier. Key from aistudio.google.com (starts with "AIza");
# never paste it anywhere else. gemini-2.5-* is closed to new users; Flash-Lite answers in
# ~1-4 s, gemini-3.8-flash was often busy (503) on the free tier.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_S=60
# Thinking models: "low" stops hidden reasoning eating max_tokens. Empty for Ollama.
LLM_REASONING_EFFORT=low
# Other options:
#   Groq:         LLM_BASE_URL=https://api.groq.com/openai/v1
#   Azure OpenAI: LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1, LLM_MODEL=<deployment>
#   Ollama:       LLM_BASE_URL=http://127.0.0.1:11434/v1, LLM_API_KEY=ollama,
#                 LLM_MODEL=qwen2.5:3b, LLM_REASONING_EFFORT=, LLM_TIMEOUT_S=120

# Retrieval used by /chat: vector (won the step 9 eval) or hybrid.
RETRIEVAL_MODE=vector
# Cross-encoder re-ranker over the top 24 (step 13) and the relevance gate on its top score
RETRIEVAL_RERANK=true
RELEVANCE_THRESHOLD=-9.7
