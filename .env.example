# Copy to .env and adjust. .env is git-ignored.

APP_ENV=dev

# Postgres (docker compose builds DATABASE_URL for the api container from these)
POSTGRES_USER=wra
POSTGRES_PASSWORD=wra
POSTGRES_DB=wra

# LLM: any OpenAI-compatible endpoint.
# Dev: Ollama running on the Windows host (not in Docker).
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b
# CPU answers take 20-60 s
LLM_TIMEOUT_S=120
